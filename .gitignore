# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# ── Wiki HTML cache ───────────────────────────────────────────────────────────
# Regenerated by running generate_sources.py — too large (800 MB+) for git
scripts/cache/

# ── Personal / runtime data ───────────────────────────────────────────────────
# These files are generated locally from your own RuneLite profile.
# They are never committed — each user generates their own.
scripts/output/my_collection.json
scripts/output/all_collections.json
scripts/output/completed_quests.json

# ── Logs ──────────────────────────────────────────────────────────────────────
scripts/output/generate.log
*.log

# ── Private notes ─────────────────────────────────────────────────────────────
discord/private-ticket.md

# ── Editor / tooling ──────────────────────────────────────────────────────────
.obsidian/
.claude/
*.swp
*.swo
.idea/
.vscode/

# ── Plugin repos (separate git repos — reference only, not part of this project) ──
plugins/

# ── Session / working files ────────────────────────────────────────────────────
CLAUDE.md
PROJECT_LOG.md
docs/bronzeman-architecture.md
docs/osrs-tcg-architecture.md
docs/opportunities.md
docs/opportunities/

# ── Research / raw data ────────────────────────────────────────────────────────
# Tracked: card-catalog-live.json (+ .version) is the catalog every generator and server.py read;
# card-catalog-v1.json and catalog_migration.json are kept for reference / name migrations
research/*
!research/card-catalog-live.json
!research/card-catalog-live.version
!research/card-catalog-v1.json
!research/catalog_migration.json

